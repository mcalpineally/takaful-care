{
  // Cloudflare Workers (static assets) config.
  // The site's built HTML lives at the repo root, so the assets directory is ".".
  // NOTE: "name" MUST match the existing Cloudflare Worker/project exactly
  // (inferred from the build-log artifact "takaful-care.production…").
  // If your project is named differently, change it here before deploying.
  "name": "takaful-care",
  "compatibility_date": "2026-10-12",
  "assets": {
    "directory": "."
  }
}
